# Copy this file to .env (in the repo root) and fill in your real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash
PORT=8787
MONGODB_URI=
SUPERMEMORY_API_KEY=
TINYFISH_API_KEY=
MARITIME_API_KEY=

# Who the fort covers for (demo owner)
DEFAULT_OWNER_ID=manaswi

# Where the web app finds the agent (local: http://localhost:8787)
AGENT_URL=http://localhost:8787

# Public URL of the team board page, once the web app is deployed
# e.g. https://holdthefort.co/board
PUBLIC_BOARD_URL=

# Name of your agent (shown everywhere)
AGENT_NAME=Sage

# Optional: Solana devnet wallet for coverage karma (run: cd agent && npm run wallet)
SOLANA_SECRET=

# Phone push when a coworker passes the Vacation Shield (free, no account).
# 1) Install the "ntfy" app on your phone  2) Subscribe to a long random topic  3) Put the same topic here
NTFY_TOPIC=
# Optional: where the push should open when tapped, e.g. https://holdthefort.club
PUBLIC_APP_URL=

# Security: shared secret between website and agent (set the SAME value on both). Long and random.
AGENT_AUTH=
# Passcode Manaswi types to open the owner pages (website only)
OWNER_PASSCODE=
# Sage voice (optional)
GEMINI_TTS_VOICE=Sulafat
GEMINI_TTS_MODELS=

# Sage voice through Amazon Polly (used when the AWS keys below are set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
POLLY_VOICE=Tiffany
POLLY_ENGINE=generative
